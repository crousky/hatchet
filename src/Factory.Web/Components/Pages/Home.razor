@page "/"
@implements IDisposable
@inject IRunStore Store
@inject FactoryEventBus Bus
@inject ModelHealthService Health
@inject FactoryOrchestrator Orchestrator
@inject AdHocManager Requests

<DocumentTitle Value="Hatchet" />

<div class="page">
    <div class="page-inner">
        <header class="page-header">
            <div>
                <h1>Runs</h1>
                <p class="muted">Hand over an architecture spec. Your local model plans, builds, tests and reviews it, one commit at a time. Each repository also takes ad hoc requests: a status report, running the software, a command or a question.</p>
            </div>
            <a class="btn btn-primary" href="/runs/new"><Icon Name="plus" Size="14" /> New run</a>
        </header>

        <ModelCard />

        @if (_runs is null)
        {
            <div class="muted pad">Loading…</div>
        }
        else if (_projects.Count == 0)
        {
            <div class="getting-started">
                <h2>Start your first run</h2>
                <ol class="steps">
                    <li>
                        <span class="step-number">1</span>
                        <div>
                            <div class="step-title">Serve the model</div>
                            <div class="muted">Load Qwen 3.8 in LM Studio and start its local server, or run it with Ollama. Hatchet uses this one model for every agent role.</div>
                        </div>
                    </li>
                    <li>
                        <span class="step-number">2</span>
                        <div>
                            <div class="step-title">Pick a repository</div>
                            <div class="muted">Any local Git repository with a clean working tree. All work happens on its own <code>factory/run-N</code> branch.</div>
                        </div>
                    </li>
                    <li>
                        <span class="step-number">3</span>
                        <div>
                            <div class="step-title">Paste your architecture spec</div>
                            <div class="muted">You review the generated plan, then watch it build. Failures loop through the fixer, and anything stuck comes back to you.</div>
                        </div>
                    </li>
                </ol>
                <a class="btn btn-primary" href="/runs/new"><Icon Name="play" Size="14" /> New run</a>
            </div>
        }
        else
        {
            @foreach (var project in _projects)
            {
                var open = IsOpen(project);
                <section class="project-group">
                    <button class="project-heading" title="@project.Repository" @onclick="() => Toggle(project)">
                        <Icon Name="@(open ? "chevron-down" : "chevron-right")" Size="13" />
                        <Icon Name="folder" Size="14" />
                        <span class="project-name">@project.Name</span>
                        <span class="project-path mono-small">@project.Repository</span>
                        <span class="project-count">
                            @(project.Open > 0 ? $"{project.Open} open · " : "")@project.Runs.Count @(project.Runs.Count == 1 ? "run" : "runs")
                            @if (project.Requests.Count > 0)
                            {
                                <text> · @(project.RunningRequests > 0 ? $"{project.RunningRequests} running · " : "")@project.Requests.Count @(project.Requests.Count == 1 ? "request" : "requests")</text>
                            }
                        </span>
                    </button>
                    @if (open)
                    {
                        @if (project.Runs.Count > 0)
                        {
                        <table class="runs-table">
                            <thead>
                                <tr>
                                    <th class="col-id">#</th>
                                    <th>Run</th>
                                    <th>Status</th>
                                    <th class="num">Tokens</th>
                                    <th class="num">Started</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var run in project.Runs)
                                {
                                    var spot = Orchestrator.GetQueueSpot(run.Id);
                                    <tr class="row-link" @onclick="@(() => Nav.NavigateTo($"/runs/{run.Id}"))">
                                        <td class="col-id muted">@run.Id</td>
                                        <td class="col-title"><a href="/runs/@run.Id">@run.Task.Title</a></td>
                                        <td>
                                            <StatusBadge Status="run.Status" PausedByUser="run.PausedByUser" Queue="spot" />
                                            @if (spot is not null)
                                            {
                                                <span class="queue-note">@Fmt.Queue(spot)</span>
                                            }
                                        </td>
                                        <td class="num muted">@Fmt.Tokens(run.PromptTokens + run.CompletionTokens)</td>
                                        <td class="num muted">@Fmt.Ago(run.CreatedAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                        }
                        <ProjectRequests Project="project" />
                    }
                </section>
            }
        }
    </div>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = null!;

    private readonly CancellationTokenSource _stop = new();
    private FactoryEventBus.Subscription? _subscription;
    private IReadOnlyList<FactoryRun>? _runs;
    private IReadOnlyList<AdHocRequest> _requests = [];
    private IReadOnlyList<ProjectGroup> _projects = [];

    // Projects the user opened or closed. The rest are open while they have open runs, and the latest project always is.
    private readonly Dictionary<string, bool> _toggled = new(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _subscription = Bus.Subscribe();
        await LoadAsync(CancellationToken.None);
        _ = PumpAsync();
    }

    private async Task LoadAsync(CancellationToken ct)
    {
        _runs = await Store.ListRunsAsync(ct);
        _requests = await Requests.ListAsync(ct: ct);
        _projects = Projects.Group(_runs, _requests);
    }

    private bool IsOpen(ProjectGroup project) =>
        _toggled.TryGetValue(project.Repository, out var open) ? open : project.Open > 0 || project.RunningRequests > 0 || project == _projects[0];

    private void Toggle(ProjectGroup project) => _toggled[project.Repository] = !IsOpen(project);

    private async Task PumpAsync()
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
            while (await timer.WaitForNextTickAsync(_stop.Token))
            {
                var changed = false;
                while (_subscription!.Reader.TryRead(out var evt))
                {
                    if (evt is RunStatusChanged or LlmCallFinished or QueueChanged or RequestChanged) changed = true;
                }
                if (!changed) continue;

                await LoadAsync(_stop.Token);
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _stop.Cancel();
        _subscription?.Dispose();
    }
}

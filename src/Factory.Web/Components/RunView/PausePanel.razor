<div class="action-banner @(Run.PausedByUser ? "action-banner-paused" : "action-banner-warn")">
    <div class="action-banner-main">
        <Icon Name="@(Run.PausedByUser ? "pause" : "alert")" Size="18" />
        <div class="action-banner-text">
            <div class="action-banner-title">@Title</div>
            @if (_brief is { NeedsDecision: true })
            {
                <div class="action-banner-reason">@_brief.Why</div>
                @if (_brief.Findings.Count > 0)
                {
                    <div class="brief-label">@_brief.FindingsLabel</div>
                    <ul class="brief-list">
                        @foreach (var finding in _brief.Findings)
                        {
                            <li>@finding</li>
                        }
                    </ul>
                }
                <div class="brief-ask"><strong>What Hatchet needs from you:</strong> @_brief.Ask</div>
                <div class="brief-label">Your options</div>
                <ul class="brief-list brief-options">
                    @foreach (var option in _brief.Options)
                    {
                        <li><strong>@option.Label</strong>: @option.When <span class="brief-provide">You provide: @option.YouProvide</span></li>
                    }
                </ul>
            }
            else
            {
                <div class="action-banner-reason">@Run.PauseReason</div>
            }
        </div>
    </div>

    @if (Run.PausedByUser)
    {
        @* The user stopped a healthy run, so it only needs to carry on. *@
        <div class="action-row">
            <button class="btn btn-primary" disabled="@Busy" title="Carry on from the step that was paused" @onclick="@(() => Decide(HumanDecision.Resume))">
                <Icon Name="play" Size="14" /> @ResumeLabel
            </button>
            @if (Paused is not null)
            {
                <ConfirmButton Text="Restart subtask" ConfirmText="Discard its changes?" IconName="rotate" Disabled="Busy" Title="Discard this subtask's uncommitted changes and redo Refine and Build" OnConfirmed="@(() => Decide(HumanDecision.RestartSubtask))" />
                <ConfirmButton Text="Skip subtask" ConfirmText="Discard and skip?" IconName="skip" Disabled="Busy" Title="Discard this subtask's uncommitted changes and move to the next one" OnConfirmed="@(() => Decide(HumanDecision.SkipSubtask))" />
            }
        </div>
    }
    else if (Paused is not null)
    {
        <textarea autocomplete="off" data-1p-ignore data-lpignore="true" class="guidance" rows="2" placeholder="@(_brief?.GuidanceHint ?? "Guidance for the agents (optional). Name the root cause, or the approach you want.")" @bind="_guidance" @bind:event="oninput"></textarea>
        @if (SaveSkill is not null)
        {
            @if (_savedSkill is not null)
            {
                <div class="hint"><Icon Name="check" Size="12" /> Saved as a project skill in <code>@_savedSkill</code>, committed on the run's branch. The Task Planner can give it to later subtasks.</div>
            }
            else if (_skillOpen)
            {
                <div class="skill-save">
                    <input autocomplete="off" data-1p-ignore data-lpignore="true" class="mono" spellcheck="false" placeholder="skill-name" @bind="_skillName" @bind:event="oninput" />
                    <input autocomplete="off" data-1p-ignore data-lpignore="true" class="grow" placeholder="When should agents use it? The Task Planner chooses skills by this." @bind="_skillDescription" @bind:event="oninput" />
                    <button class="btn" disabled="@(Busy || _saving || string.IsNullOrWhiteSpace(_guidance) || string.IsNullOrWhiteSpace(_skillName) || string.IsNullOrWhiteSpace(_skillDescription))" title="Write the guidance to .hatchet/skills in the repository and commit it on the run's branch" @onclick="SaveSkillAsync">
                        <Icon Name="check" Size="14" /> Save skill
                    </button>
                    <button class="btn btn-ghost" @onclick="@(() => _skillOpen = false)">Cancel</button>
                </div>
            }
            else
            {
                <div><button class="link-button small" disabled="@string.IsNullOrWhiteSpace(_guidance)" title="Keep this guidance for later subtasks and runs in this repository" @onclick="@(() => _skillOpen = true)">Save this guidance as a project skill</button></div>
            }
        }
        <div class="action-row">
            @if (Interrupted)
            {
                @* Nothing went wrong, so carrying on comes first, without resetting the fix budget. *@
                <button class="btn btn-primary" disabled="@Busy" title="Carry on from the step Hatchet was on when it stopped" @onclick="@(() => Decide(HumanDecision.Resume))">
                    <Icon Name="play" Size="14" /> Resume
                </button>
            }
            @if (Paused.LastFailure is not null)
            {
                <button class="btn @(Interrupted ? "" : "btn-primary")" disabled="@Busy" title="Send the failure and your guidance to the Bug Fixer, with a fresh retry budget" @onclick="@(() => Decide(HumanDecision.RetryFixer))">
                    <Icon Name="wrench" Size="14" /> Retry with Fixer
                </button>
            }
            @if (Paused.SummaryOfChanges is not null)
            {
                <button class="btn" disabled="@Busy" title="Run verification on the working tree as it is now. Use this after fixing it by hand." @onclick="@(() => Decide(HumanDecision.Reverify))">
                    <Icon Name="terminal" Size="14" /> I fixed it, re-verify
                </button>
            }
            else if (!Interrupted)
            {
                <button class="btn btn-primary" disabled="@Busy" title="Continue this subtask from where it stopped" @onclick="@(() => Decide(HumanDecision.Resume))">
                    <Icon Name="play" Size="14" /> Resume
                </button>
            }
            <ConfirmButton Text="Restart subtask" ConfirmText="Discard its changes?" IconName="rotate" Disabled="Busy" Title="Discard this subtask's uncommitted changes and redo Refine and Build" OnConfirmed="@(() => Decide(HumanDecision.RestartSubtask))" />
            <ConfirmButton Text="Skip subtask" ConfirmText="Discard and skip?" IconName="skip" Disabled="Busy" Title="Discard this subtask's uncommitted changes and move to the next one" OnConfirmed="@(() => Decide(HumanDecision.SkipSubtask))" />
        </div>
    }
    else
    {
        <div class="action-row">
            <button class="btn btn-primary" disabled="@Busy" @onclick="@(() => Decide(HumanDecision.Resume))">
                <Icon Name="play" Size="14" /> @ResumeLabel
            </button>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public FactoryRun Run { get; set; } = null!;
    [Parameter] public FactorySubtask? Paused { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<(HumanDecision Decision, string? Guidance)> OnDecision { get; set; }

    /// <summary>Saves the guidance as a project skill, given its name and description. Returns the skill's path, or null if it wasn't saved.</summary>
    [Parameter] public Func<string, string, string, Task<string?>>? SaveSkill { get; set; }

    private PauseBrief? _brief;
    private string? _guidance;
    private bool _skillOpen;
    private bool _saving;
    private string? _skillName;
    private string? _skillDescription;
    private string? _savedSkill;

    // Worked out once per change of run or subtask, not on every keystroke in the guidance box.
    protected override void OnParametersSet() => _brief = PauseBriefBuilder.Build(Run, Paused);

    private async Task SaveSkillAsync()
    {
        _saving = true;
        try
        {
            _savedSkill = await SaveSkill!(_skillName ?? "", _skillDescription ?? "", _guidance ?? "");
            if (_savedSkill is not null) _skillOpen = false;
        }
        finally
        {
            _saving = false;
        }
    }

    private bool Interrupted => Run.PauseReason == FactoryOrchestrator.InterruptedReason;

    private string Title => Run.PausedByUser
        ? Paused is not null ? $"Paused on \"{Paused.Title}\"" : "Paused"
        : Paused is not null ? $"Stopped on \"{Paused.Title}\"" : "This run is paused";

    private string ResumeLabel => Run.PausedStage switch
    {
        PipelineStage.Ingest => "Scan again",
        PipelineStage.Decompose when !Run.PausedByUser && Run.Task.SuppliedPlanJson is null => "Plan again",
        PipelineStage.Integrate => "Run the final check again",
        _ => "Resume"
    };

    private Task Decide(HumanDecision decision) => OnDecision.InvokeAsync((decision, _guidance));
}

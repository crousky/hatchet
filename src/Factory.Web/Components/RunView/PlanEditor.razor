<div class="plan">
    @if (Editable && Amending)
    {
        <div class="plan-toolbar">
            <div>
                <div class="plan-title">@(FromAgent ? "The driving agent proposed these steps" : "Change the steps not started yet")</div>
                <div class="muted small">
                    @if (FromAgent)
                    {
                        <text>They would replace the @Replaces not started yet. Nothing changes until you approve. Edit anything first, and check the commands: they run on this machine once you do.</text>
                    }
                    else
                    {
                        <text>Edit, add, remove or reorder them. Steps that are done or under way stay as they are. The commands below run on this machine once you save, so check them.</text>
                    }
                </div>
            </div>
            <span class="toolbar-spacer"></span>
            <button class="btn" disabled="@Busy" @onclick="() => OnCancel.InvokeAsync()">@(FromAgent ? "Discard" : "Cancel")</button>
            <button class="btn btn-primary" disabled="@Busy" @onclick="ApproveAsync">
                <Icon Name="check" Size="14" /> @(FromAgent ? "Approve changes" : "Save changes")
            </button>
        </div>
    }
    else if (Editable)
    {
        <div class="plan-toolbar">
            <div>
                <div class="plan-title">Review the plan</div>
                <div class="muted small">@_items.Count subtasks. Edit anything, then approve. The commands below run on this machine once you do, so check them.</div>
            </div>
            <span class="toolbar-spacer"></span>
            <button class="btn btn-primary" disabled="@(Busy || _items.Count == 0)" @onclick="ApproveAsync">
                <Icon Name="play" Size="14" /> Approve and build
            </button>
        </div>
    }

    @if (!Editable && Amendable)
    {
        <div class="plan-amend-bar">
            <span class="muted small">The run is paused. The steps that haven't started can still be changed.</span>
            <button class="btn btn-small" disabled="@Busy" @onclick="() => OnStartAmend.InvokeAsync()"><Icon Name="clipboard" Size="13" /> Change the steps not started</button>
        </div>
    }

    @if (_items.Count == 0)
    {
        <div class="empty-state">
            @if (Queued)
            {
                <div class="empty-title">Waiting in line</div>
                <div class="muted">The plan comes once this run's turn comes.</div>
            }
            else if (Planning)
            {
                <span class="spinner spinner-large"></span>
                <div class="empty-title">The Task Planner is working</div>
                <div class="muted">Its reasoning is streaming in the agent panel.</div>
            }
            else
            {
                <div class="empty-title">@(Amending ? "No steps left to build" : "No subtasks")</div>
                @if (Editable)
                {
                    <button class="btn" @onclick="AddItem"><Icon Name="plus" Size="14" /> Add a subtask</button>
                }
            }
        </div>
    }

    @for (var i = 0; i < _items.Count; i++)
    {
        var index = i;
        var item = _items[i];
        <div class="plan-card" @key="item">
            @if (Editable)
            {
                <div class="plan-card-head">
                    <span class="plan-number">@(NumberOffset + index + 1)</span>
                    <input autocomplete="off" data-1p-ignore data-lpignore="true" class="plan-input-title" placeholder="Subtask title" @bind="item.Title" />
                    <button class="icon-button" title="Move up" disabled="@(index == 0)" @onclick="@(() => Move(index, -1))"><Icon Name="arrow-up" Size="14" /></button>
                    <button class="icon-button" title="Move down" disabled="@(index == _items.Count - 1)" @onclick="@(() => Move(index, 1))"><Icon Name="arrow-down" Size="14" /></button>
                    <button class="icon-button icon-button-danger" title="Remove" @onclick="@(() => _items.RemoveAt(index))"><Icon Name="trash" Size="14" /></button>
                </div>
                <textarea autocomplete="off" data-1p-ignore data-lpignore="true" class="plan-input-body" rows="3" placeholder="What to build and how it fits" @bind="item.Description"></textarea>
                <div class="plan-fields">
                    <label>
                        <span>Modify</span>
                        <input autocomplete="off" data-1p-ignore data-lpignore="true" class="mono" spellcheck="false" placeholder="comma separated" @bind="item.Modify" />
                    </label>
                    <label>
                        <span>Create</span>
                        <input autocomplete="off" data-1p-ignore data-lpignore="true" class="mono" spellcheck="false" placeholder="comma separated" @bind="item.Create" />
                    </label>
                    <label>
                        <span>Read for context</span>
                        <input autocomplete="off" data-1p-ignore data-lpignore="true" class="mono" spellcheck="false" placeholder="comma separated" @bind="item.Context" />
                    </label>
                    <label>
                        <span>Skills</span>
                        <input autocomplete="off" data-1p-ignore data-lpignore="true" class="mono" spellcheck="false" placeholder="comma separated" @bind="item.Skills" />
                    </label>
                    <label title="@StrongHint">
                        <span>Built on</span>
                        <select @bind="item.Tier">
                            <option value="@SubtaskTiers.Local">The run's models (local tier)</option>
                            <option value="@SubtaskTiers.Strong">The strong profile's models (strong tier)</option>
                        </select>
                    </label>
                </div>
                <div class="plan-command">
                    <label>
                        <span>Verify with</span>
                        @if (item.Proposed)
                        {
                            <span class="plan-command-proposed">@(FromAgent ? "proposed by the driving agent" : "proposed by the model")</span>
                        }
                        <textarea autocomplete="off" data-1p-ignore data-lpignore="true" class="plan-command-input" rows="3" spellcheck="false" wrap="soft" placeholder="@(string.IsNullOrEmpty(DefaultCommand) ? "Detect from the repository" : DefaultCommand)" value="@item.Command" @oninput="@(e => OnCommandInput(item, e.Value?.ToString() ?? ""))"></textarea>
                    </label>
                    @if (item.Proposed)
                    {
                        <label class="plan-command-run">
                            <input type="checkbox" @bind="item.RunProposed" />
                            <span>Run this command</span>
                        </label>
                    }
                    @if (HasHiddenSpacing(item.Command))
                    {
                        <div class="plan-command-warning">This command contains hidden or unusual spacing — read all of it before approving.</div>
                    }
                </div>
            }
            else
            {
                <div class="plan-card-head">
                    <span class="plan-number">@(index + 1)</span>
                    <span class="plan-readonly-title">@item.Title</span>
                    @if (SubtaskTiers.IsStrong(item.Tier))
                    {
                        <span class="file-chip file-skill" title="@StrongHint">strong</span>
                    }
                </div>
                <div class="plan-readonly-body">@item.Description</div>
                <div class="plan-chips">
                    @foreach (var file in Split(item.Modify))
                    {
                        <span class="file-chip file-modify" title="Modify">@file</span>
                    }
                    @foreach (var file in Split(item.Create))
                    {
                        <span class="file-chip file-create" title="Create">@file</span>
                    }
                    @foreach (var file in Split(item.Context))
                    {
                        <span class="file-chip" title="Read for context">@file</span>
                    }
                    @foreach (var skill in Split(item.Skills))
                    {
                        <span class="file-chip file-skill" title="Skill">@skill</span>
                    }
                </div>
            }
        </div>
    }

    @if (Editable)
    {
        <div class="plan-footer">
            <button class="btn" @onclick="AddItem"><Icon Name="plus" Size="14" /> Add subtask</button>
            @if (!Amending)
            {
                <div class="plan-regenerate">
                    <input autocomplete="off" data-1p-ignore data-lpignore="true" placeholder="What should the planner change? (optional)" @bind="_feedback" />
                    <button class="btn" disabled="@Busy" @onclick="() => OnRegenerate.InvokeAsync(_feedback)"><Icon Name="refresh" Size="14" /> Plan again</button>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<FactorySubtask> Subtasks { get; set; } = [];
    [Parameter] public bool Editable { get; set; }
    [Parameter] public bool Planning { get; set; }

    /// <summary>The run is waiting in line for a worker, so planning hasn't started.</summary>
    [Parameter] public bool Queued { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public string DefaultCommand { get; set; } = "";

    /// <summary>Where a strong subtask's building agents run, as Settings has the strong profile now.</summary>
    [Parameter] public string StrongModels { get; set; } = "";

    private string StrongHint => "A strong subtask's Context Specifier, Code Generator and Bug Fixer run on the strong run profile's models"
        + (StrongModels.Length > 0 ? $": {StrongModels}." : ".") + " Every other subtask is built on the run's own.";
    [Parameter] public EventCallback<IReadOnlyList<SubtaskEdit>> OnApprove { get; set; }

    /// <summary>The editor holds only the steps of a paused run that haven't started, and saving replaces those.</summary>
    [Parameter] public bool Amending { get; set; }

    /// <summary>The steps being amended are an MCP client's proposal, waiting for the user's approval.</summary>
    [Parameter] public bool FromAgent { get; set; }

    /// <summary>How many steps the amendment replaces, in words, such as "2 steps".</summary>
    [Parameter] public string Replaces { get; set; } = "";

    /// <summary>How many steps come before the ones shown, so the numbers match the run's.</summary>
    [Parameter] public int NumberOffset { get; set; }

    /// <summary>Changes when the steps to load change though their ids don't, as with a new proposal.</summary>
    [Parameter] public string Version { get; set; } = "";

    /// <summary>The plan is read-only here, and the run is paused with steps that could be amended.</summary>
    [Parameter] public bool Amendable { get; set; }
    [Parameter] public EventCallback OnStartAmend { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback<string?> OnRegenerate { get; set; }

    private sealed class PlanItem
    {
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public string Modify { get; set; } = "";
        public string Create { get; set; } = "";
        public string Context { get; set; } = "";
        public string Skills { get; set; } = "";
        public string Tier { get; set; } = SubtaskTiers.Local;
        public string Command { get; set; } = "";

        /// <summary>The command as loaded from the plan.</summary>
        public string OriginalCommand { get; set; } = "";

        /// <summary>The model proposed this command and the user has not approved it before.</summary>
        public bool Proposed { get; set; }

        /// <summary>The user ticked "Run this command" (or edited the text, making it their own).</summary>
        public bool RunProposed { get; set; }
    }

    private static void OnCommandInput(PlanItem item, string text)
    {
        item.Command = text;
        if (item.Proposed && text != item.OriginalCommand) item.RunProposed = true;
    }

    private static bool HasHiddenSpacing(string command)
    {
        var run = 0;
        foreach (var c in command)
        {
            if (char.IsControl(c)) return true;
            run = char.IsWhiteSpace(c) ? run + 1 : 0;
            if (run >= 8) return true;
        }
        return false;
    }

    private List<PlanItem> _items = [];
    private string _loadedSignature = "";
    private string? _feedback;

    protected override void OnParametersSet()
    {
        // Only a new plan from the server replaces the form, so periodic refreshes don't discard edits.
        var signature = string.Join(',', Subtasks.Select(s => s.Id)) + $"|{Editable}|{Amending}|{Version}";
        if (signature == _loadedSignature) return;
        _loadedSignature = signature;
        _items = Subtasks.Select(s => new PlanItem
        {
            Title = s.Title,
            Description = s.Description,
            Modify = string.Join(", ", s.TargetFilesToModify),
            Create = string.Join(", ", s.TargetFilesToCreate),
            Context = string.Join(", ", s.ContextFilesToRead),
            Skills = string.Join(", ", s.Skills),
            Tier = SubtaskTiers.Parse(s.Tier) ?? SubtaskTiers.Local,
            Command = s.VerificationCommand,
            OriginalCommand = s.VerificationCommand,
            Proposed = !string.IsNullOrEmpty(s.VerificationCommand) && !s.CommandApproved
        }).ToList();
    }

    private void AddItem() => _items.Add(new PlanItem { Title = "New subtask" });

    private void Move(int index, int delta)
    {
        var item = _items[index];
        _items.RemoveAt(index);
        _items.Insert(index + delta, item);
    }

    private static List<string> Split(string files) =>
        files.Split([',', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList();

    private Task ApproveAsync() => OnApprove.InvokeAsync(_items
        .Select(i => new SubtaskEdit(null, i.Title, i.Description, Split(i.Modify), Split(i.Create), Split(i.Context), i.Proposed && !i.RunProposed ? "" : i.Command, Split(i.Skills), i.Tier))
        .ToList());
}
